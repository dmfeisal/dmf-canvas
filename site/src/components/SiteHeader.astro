---
// One-row site navigation shared by the home page and every Starlight docs page (via the Header override).
// Lucide 1.60.0 artwork (ISC, see LICENSES/lucide.txt) and the GitHub mark are inlined; no icon dependency.
const path=Astro.url.pathname;
const current=path==='/'?'home':path.startsWith('/docs/changelog/')?'changelog':path.startsWith('/labs/import/')?'lab':path.startsWith('/docs/')?'docs':'';
const icon=(paths:string,size=16)=>`<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
const icons={
 monitor:icon('<rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>',18),
 sun:icon('<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',18),
 moon:icon('<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',18),
 github:'<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12c0 5.303 3.438 9.8 8.205 11.385c.6.113.82-.258.82-.577c0-.285-.01-1.04-.015-2.04c-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729c1.205.084 1.838 1.236 1.838 1.236c1.07 1.835 2.809 1.305 3.495.998c.108-.776.417-1.305.76-1.605c-2.665-.3-5.466-1.332-5.466-5.93c0-1.31.465-2.38 1.235-3.22c-.135-.303-.54-1.523.105-3.176c0 0 1.005-.322 3.3 1.23c.96-.267 1.98-.399 3-.405c1.02.006 2.04.138 3 .405c2.28-1.552 3.285-1.23 3.285-1.23c.645 1.653.24 2.873.12 3.176c.765.84 1.23 1.91 1.23 3.22c0 4.61-2.805 5.625-5.475 5.92c.42.36.81 1.096.81 2.22c0 1.606-.015 2.896-.015 3.286c0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>',
};
const nav=[
 {id:'home',label:'Home',href:'/',icon:icon('<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>')},
 {id:'docs',label:'Docs',href:'/docs/',icon:icon('<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>')},
 {id:'lab',label:'Import lab',href:'/labs/import/',icon:icon('<path d="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2"/><path d="M6.453 15h11.094"/><path d="M8.5 2h7"/>')},
 {id:'changelog',label:'Changelog',href:'/docs/changelog/',icon:icon('<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>')},
];
const hasSearch=Astro.slots.has('search');
---
<div class="site-nav" data-has-search={hasSearch?'':undefined}>
 <a class="site-nav__logo" href="/" aria-label="DMF Canvas home">DMF Canvas</a>
 <nav class="site-nav__links" aria-label="Primary">
  {nav.map(item=><a href={item.href} aria-current={current===item.id?'page':undefined}><Fragment set:html={item.icon}/><span>{item.label}</span></a>)}
 </nav>
 <div class="site-nav__actions">
  {hasSearch&&<div class="site-nav__search"><slot name="search"/></div>}
  <a class="site-nav__icon" href="https://github.com/dmfeisal/dmf-canvas"><Fragment set:html={icons.github}/><span class="site-nav__sr">GitHub repository</span></a>
  <button class="site-nav__icon" type="button" data-theme-toggle aria-label="Theme: System" title="Theme: System. Switch to Light.">
   <span data-theme-icon="system"><Fragment set:html={icons.monitor}/></span>
   <span data-theme-icon="light" hidden><Fragment set:html={icons.sun}/></span>
   <span data-theme-icon="dark" hidden><Fragment set:html={icons.moon}/></span>
  </button>
 </div>
</div>

<script>
 // System → Light → Dark, stored under Starlight's own key ('' = system) so docs and the home page agree.
 const key='starlight-theme',modes=['system','light','dark'] as const;type Mode=typeof modes[number];
 const media=matchMedia('(prefers-color-scheme: dark)'),root=document.documentElement;
 const read=():Mode=>{try{const value=localStorage.getItem(key);return value==='light'||value==='dark'?value:'system';}catch{return 'system';}};
 const title=(value:string)=>value[0].toUpperCase()+value.slice(1);
 let mode=read();
 function apply(){
  const theme=mode==='system'?(media.matches?'dark':'light'):mode;
  if(root.dataset.theme!==theme)root.dataset.theme=theme;
  for(const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')){
   const label=`Theme: ${title(mode)}`;button.setAttribute('aria-label',label);button.title=`${label}. Switch to ${title(modes[(modes.indexOf(mode)+1)%modes.length])}.`;
   for(const icon of button.querySelectorAll<HTMLElement>('[data-theme-icon]'))icon.hidden=icon.dataset.themeIcon!==mode;
  }
  document.dispatchEvent(new CustomEvent('site-theme-change',{detail:{mode,theme}}));
 }
 for(const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'))button.addEventListener('click',()=>{
  mode=modes[(modes.indexOf(mode)+1)%modes.length];
  try{localStorage.setItem(key,mode==='system'?'':mode);}catch{}
  apply();
 });
 media.addEventListener('change',()=>{if(mode==='system')apply();});
 apply();
</script>

<style is:global>
 /* Own the box model so the row is identical on any host page, whatever its global reset. */
 .site-nav,.site-nav *{box-sizing:border-box}
 .site-nav{display:flex;align-items:center;gap:16px;height:100%;min-width:0;font-family:-apple-system,system-ui,"Segoe UI",Roboto,"Helvetica Neue","Noto Sans",Arial,sans-serif}
 .site-nav svg{flex:none}
 .site-nav__logo{flex:none;font-size:1.3rem;font-weight:700;letter-spacing:-.04em;line-height:1.5;color:var(--foreground);text-decoration:none}
 .site-nav__links{display:flex;align-items:center;gap:4px;min-width:0;overflow-x:auto;scrollbar-width:none;padding:2px}
 .site-nav__links a{display:inline-flex;align-items:center;gap:8px;height:32px;padding:4px 8px;border-radius:8px;font-size:14px;font-weight:600;line-height:1;white-space:nowrap;text-decoration:none;color:var(--muted-foreground)}
 .site-nav__links a:hover{background:var(--accent);color:var(--accent-foreground)}
 .site-nav__links a[aria-current="page"]{background:var(--muted);color:var(--accent-foreground)}
 .site-nav__actions{display:flex;align-items:center;gap:8px;margin-inline-start:auto;flex:none}
 .site-nav__icon{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;padding:0;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--foreground);cursor:pointer;text-decoration:none}
 .site-nav__icon:hover{background:var(--accent)}
 .site-nav__icon span{display:inline-flex}.site-nav__icon [hidden]{display:none}
 .site-nav :focus-visible{outline:2px solid var(--ring);outline-offset:2px}
 .site-nav__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
 /* Narrow screens: icon-only links; docs pages hide them because the docs menu lists the same destinations. */
 @media (max-width:40rem){
  .site-nav{gap:8px}
  .site-nav__links a{width:32px;padding:0;justify-content:center}
  .site-nav__links a span{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
 }
 @media (max-width:50rem){.site-nav[data-has-search] .site-nav__links{display:none}}
</style>
