---
import '../../../css/canvas-instance.css';
import '../../../css/canvas-instance-toolbar.css';
import '../../../examples/configurator/canvas-embed.css';
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Try the DMF Canvas editor: edit Text, add sticky notes, draw, and save a board locally." />
  <link rel="canonical" href="https://canvas.feisal.id/playground/" />
  <link rel="icon" href="/favicon.svg" />
  <title>Try Canvas | DMF Canvas</title>
 </head>
 <body>
  <a class="skip" href="#canvas-demo">Skip to Canvas</a>
  <header class="site-header"><a class="brand" href="/">DMF Canvas</a><nav aria-label="Main"><a href="/">Documentation</a><a href="https://github.com/dmfeisal/dmf-canvas">GitHub</a></nav></header>
  <main>
   <div class="intro"><div><h1>Try Canvas.</h1><p>Write, sketch, and arrange your ideas. Everything you make stays in this browser tab until you save a board file.</p></div><span class="version">Editor preview · 0.3.0-alpha.1</span></div>
   <section class="workspace" aria-label="Canvas playground">
    <div class="workspace-heading"><h2>Your canvas</h2><div class="host-actions"><button id="add-text" type="button" disabled>Add text</button><label>Theme <select id="theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></label><button id="reset" type="button" disabled>Reset demo</button></div></div>
    <p id="canvas-help" class="hint">Drag to move. Double-click Text to edit. Select an object, then open the Selection inspector to change its position or Text style.</p>
    <div id="canvas-demo" tabindex="-1" aria-describedby="canvas-help"></div>
    <output id="playground-status" aria-live="polite">Loading the editor…</output>
    <noscript><p>JavaScript is required for this editor. You can still read the <a href="/getting-started/">integration guide</a>.</p></noscript>
   </section>
   <details class="help"><summary>Keyboard controls, saving, and limits</summary><div><p><strong>Keyboard:</strong> Tab to an object. Press Enter or F2 to edit Text, and Escape to finish. Arrow keys move a selected object. Use the toolbar for Undo, Redo, grouping, locks, and layers.</p><p><strong>Saving:</strong> Save board downloads a DMF Canvas JSON file. Open board restores that file. There is no automatic storage or upload; refreshing or leaving this page discards unsaved edits. Opening a board starts new history.</p><p><strong>Images:</strong> Add a local PNG, JPEG, or WebP. Images stay in the local board; they are not uploaded. Select an image to edit its description.</p><p><strong>Limits:</strong> Up to 50 objects on a bounded surface. This preview has no pan/zoom, general shapes, Excalidraw/FigJam import, or published visitor viewer. Touch-only use and other browser engines have not been certified.</p></div></details>
   <footer><a href="/text-formatting/">Text formatting guide</a><a href="/product/product-roadmap/">What’s planned</a><a href="/compatibility/">Compatibility</a></footer>
  </main>
  <script>
   import {mountEmbed} from '../../../examples/configurator/canvas-embed.js';
   import {canvasDocuments} from '../../../owners.js';
   const container=document.getElementById('canvas-demo')!;
   const status=document.getElementById('playground-status')!;
   const add=document.getElementById('add-text') as HTMLButtonElement;
   const reset=document.getElementById('reset') as HTMLButtonElement;
   const theme=document.getElementById('theme') as HTMLSelectElement;
   let embed:ReturnType<typeof mountEmbed>|null=null,unsubscribe:(()=>void)|null=null;
   function render(){const state=embed?.canvas?.getState();add.disabled=!state?.canCreate;reset.disabled=!state;status.textContent=state?.dirty?'Unsaved changes — Save board to keep a local copy.':'Ready. Edits stay in this tab; save a board before leaving.';}
   function mount(){
    embed=mountEmbed(container,{width:1600,height:480,theme:theme.value});
    embed.root!.querySelector('[data-host]')!.setAttribute('aria-describedby','canvas-help');
    unsubscribe=embed.canvas!.subscribe(render);render();
   }
   function dispose(){unsubscribe?.();unsubscribe=null;embed?.dispose();embed=null;}
   try{mount();}catch(error){dispose();status.textContent='The editor could not start. Please reload or check the compatibility guide.';console.error(error);}
   add.addEventListener('click',()=>{
    const canvas=embed?.canvas,host=embed?.root?.querySelector('[data-host]') as HTMLElement|null;
    if(!canvas?.getState().canCreate||!host)return;
    const text='New text',width=Math.min(180,host.clientWidth-48);
    const item=canvasDocuments.create(host,{type:'text',text,layout:{left:24,top:120,width,height:32,fontSize:20},state:{x:0,y:0,scale:1,angle:0,width:width+'px',content:text}});
    try{canvas.register(item.element,item.owner,{created:true});canvas.select(item.element);item.element.focus({preventScroll:true});canvas.execute('edit');}catch(error){item.owner.dispose();status.textContent='Text could not be added.';console.error(error);}
   });
   theme.addEventListener('change',()=>{if(embed)embed.update({...embed.getConfig(),theme:theme.value});});
   reset.addEventListener('click',()=>{if(!embed)return;if(embed.canvas?.getState().dirty&&!confirm('Reset this demo and discard unsaved edits? Save a board first to keep them.'))return;dispose();mount();});
   window.addEventListener('pagehide',()=>{unsubscribe?.();unsubscribe=null;});
   window.addEventListener('pageshow',event=>{if(event.persisted&&embed){unsubscribe?.();unsubscribe=embed.canvas?.subscribe(render)??null;render();}});
  </script>
 </body>
</html>
<style is:global>
 :root{color-scheme:light dark;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:CanvasText;background:Canvas;--accent:light-dark(#185cab,#8ebdff)}
 *{box-sizing:border-box}body{margin:0}a{color:var(--accent);text-underline-offset:3px}button,select{font:inherit;color:inherit;background:Canvas;border:1px solid GrayText;border-radius:6px;min-height:44px;padding:8px 12px}button{cursor:pointer}button:disabled{opacity:.5;cursor:default}:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.skip{position:absolute;left:16px;top:-80px}.skip:focus{top:8px;z-index:10;background:Canvas;padding:12px}.site-header{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px max(24px,calc((100vw - 1240px)/2));border-bottom:1px solid color-mix(in srgb,CanvasText 15%,transparent)}.brand{text-decoration:none;font-size:22px;font-weight:650;letter-spacing:-.04em}.site-header nav{display:flex;gap:20px;font-size:14px}main{max-width:1240px;margin:auto;padding:40px 24px}.intro{display:flex;justify-content:space-between;align-items:start;gap:24px;margin-bottom:28px}h1{font-size:clamp(2rem,5vw,3.3rem);line-height:1.1;letter-spacing:-.045em;margin:0 0 14px}.intro p{max-width:68ch;line-height:1.65;margin:0;font-size:16px}.version{white-space:nowrap;font-size:13px;color:GrayText;padding-top:10px}.workspace{border:1px solid color-mix(in srgb,CanvasText 20%,transparent);border-radius:10px;padding:20px;min-width:0}.workspace-heading{display:flex;justify-content:space-between;align-items:center;gap:16px}h2{font-size:18px;margin:0}.host-actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.host-actions label{display:flex;align-items:center;gap:8px;font-size:13px}.hint{font-size:14px;line-height:1.6;max-width:90ch;margin:12px 0 18px;color:GrayText}#canvas-demo{min-width:0}.configured-canvas .embed-fields button,.configured-canvas .embed-fields select{padding:8px 10px;min-height:44px}.configured-canvas .embed-fields label{flex-wrap:wrap}.configured-canvas .embed-fields{gap:10px 16px}.configured-canvas [data-host]{border-radius:5px}#playground-status{display:block;min-height:22px;font-size:13px;line-height:1.5;margin-top:14px;color:GrayText}.help{margin:24px 0;max-width:85ch;line-height:1.7}.help summary{cursor:pointer;min-height:44px;padding:10px 0;font-weight:600}.help p{font-size:14px}footer{display:flex;flex-wrap:wrap;gap:20px;font-size:14px;margin-top:28px}@media(max-width:640px){main{padding:28px 16px}.site-header{padding:16px}.site-header nav{gap:12px;font-size:13px}.intro{display:block}.version{display:block;margin-top:12px}.workspace{padding:12px}.workspace-heading{display:block}.host-actions{margin-top:12px}.configured-canvas .embed-fields{gap:8px}.hint{font-size:13px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>
