---
import '../../../../css/canvas-instance.css';
import '../../../../css/canvas-instance-toolbar.css';
import '../../../../examples/configurator/canvas-embed.css';
import '../../styles/tokens.css';
import SiteHeader from '../../components/SiteHeader.astro';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>Portable import lab | DMF Canvas</title><script is:inline>(()=>{let saved='';try{saved=localStorage.getItem('starlight-theme')||'';}catch{}document.documentElement.dataset.theme=saved==='light'||saved==='dark'?saved:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';})();</script></head><body>
<header class="site-header"><SiteHeader /></header>
<main><h1>Portable import lab</h1><p>Experimental local-file import. Text and freehand strokes convert to editable objects. Other elements receive an explicit unsupported report. Nothing is uploaded.</p>
<section class="controls" aria-label="Import controls"><label>Excalidraw file <input id="source-file" type="file" accept=".excalidraw,application/json"/></label><button id="sample">Preview synthetic sample</button><button id="apply" disabled>Apply preview</button><button id="save">Save portable document</button><label>Open portable document <input id="portable-file" type="file" accept="application/json,.json"/></label></section>
<p>Previewing preserves the current board. Applying replaces it and starts new history. Save your work first. The sample is a hand-authored schema fixture, not evidence of real-board fidelity.</p>
<output id="message" aria-live="polite">Choose a file or preview the sample.</output><ul id="report" aria-label="Import compatibility report"></ul>
<div id="editor" class="configured-canvas"><div class="canvas-embed-chrome"><div id="host" data-host data-canvas-theme-surface role="group" aria-label="Portable canvas"></div><div class="canvas-embed-chrome__slot" data-chrome-slot="tools" id="tools"></div><div class="canvas-embed-chrome__slot" data-chrome-slot="history" id="history"></div><div class="canvas-embed-chrome__slot" data-chrome-slot="selection" id="toolbar"></div></div></div>
<p>Double-click Text or focus it and press F2 to edit; Escape finishes. Use Pencil to add a stroke. Select an object to inspect it. Files are bounded to 1 MiB and 50 source elements/nodes. Fonts, colors, stroke pressure, groups and bindings are not preserved exactly. This lab has no camera; the surface can contain imported placement.</p>
</main>
<script>
 import {createCanvas} from '../../../../index.js';
 import {canvasDocuments} from '../../../../owners.js';
 import {importExcalidraw,validatePortableDocument} from '../../../../documents.js';
 import {createCanvasToolbar,createCanvasInspector} from '../../../../toolbar.js';
 import {createPencil} from '../../../../pencil.js';
 import {createCanvasTheme} from '../../../../theme.js';
 import sample from '../../../../tests/fixtures/portable-excalidraw.excalidraw?raw';
 const host=document.getElementById('host')!,editor=document.getElementById('editor')!,message=document.getElementById('message')!,report=document.getElementById('report')!,apply=document.getElementById('apply') as HTMLButtonElement;
 const canvas=createCanvas(host,{documents:canvasDocuments});Object.assign(host,{canvasLab:canvas});
 const resolved=()=>document.documentElement.dataset.theme==='dark'?'dark':'light';
 const theme=createCanvasTheme(editor,{mode:resolved()});
 document.addEventListener('site-theme-change',()=>theme.configure({mode:resolved()}));
 const pencil=createPencil(canvas,host,()=>sync());
 let pending:ReturnType<typeof importExcalidraw>|null=null,generation=0,alive=true;
 const execute=(command:'undo'|'redo'|'duplicate'|'delete')=>{pencil.setActive(false);canvas.execute(command);};
 // Standard floating chrome (docs/design/TOOLBAR.md): tool rail, history, selection actions.
 const tools=createCanvasToolbar(document.getElementById('tools')!,{label:'Tools',orientation:'vertical',actions:[{id:'select',label:'Select',icon:'mouse-pointer-2',shortcut:'V',run:()=>pencil.setActive(false)},{id:'pencil',label:'Pencil',icon:'pencil',shortcut:'P',run:()=>drawWith('pencil')},{id:'highlighter',label:'Highlighter',icon:'highlighter',shortcut:'Shift P',run:()=>drawWith('highlighter')},{id:'eraser',label:'Stroke eraser',icon:'eraser',shortcut:'E',run:()=>drawWith('eraser')}]});
 function drawWith(tool:'pencil'|'highlighter'|'eraser'){const s=pencil.getState();if(s.active&&s.tool===tool)pencil.setActive(false);else if(pencil.setTool(tool))pencil.setActive(true);}
 const history=createCanvasToolbar(document.getElementById('history')!,{label:'History',actions:[{id:'undo',label:'Undo',icon:'undo-2',shortcut:'Z',run:()=>execute('undo')},{id:'redo',label:'Redo',icon:'redo-2',shortcut:'Shift Z',run:()=>execute('redo')}]});
 const toolbar=createCanvasToolbar(document.getElementById('toolbar')!,{label:'Selection actions',actions:[{id:'inspect',label:'Selection inspector',icon:'sliders-horizontal',run:()=>inspector.toggle()},{id:'duplicate',label:'Duplicate',icon:'copy-plus',shortcut:'D',run:()=>execute('duplicate')},{id:'delete',label:'Delete',icon:'trash',shortcut:'Delete',run:()=>execute('delete')}]});
 const inspector=createCanvasInspector(editor,{canvas,trigger:editor.querySelector('[aria-label="Selection inspector"]')!});
 function sync(){const s=canvas.getState(),ink=pencil.getState(),drawing=ink.active;history.update('undo',{disabled:!s.canUndo});history.update('redo',{disabled:!s.canRedo});toolbar.update('duplicate',{disabled:!s.canDuplicate});toolbar.update('delete',{disabled:!s.canDelete});tools.update('select',{pressed:!drawing});tools.update('pencil',{pressed:drawing&&ink.tool==='pencil'});tools.update('highlighter',{pressed:drawing&&ink.tool==='highlighter'});tools.update('eraser',{pressed:drawing&&ink.tool==='eraser'});}
 const off=canvas.subscribe(sync);sync();
 function preview(input:unknown){pending=null;apply.disabled=true;report.replaceChildren();try{const result=importExcalidraw(input);for(const row of result.report){const li=document.createElement('li');li.textContent=row.sourceId+' — '+row.status+': '+row.reasons.join(' ');report.append(li);}pending=result;apply.disabled=!result.document.nodes.length;message.textContent=result.document.nodes.length+' converted, '+result.report.filter(row=>row.status==='Unsupported').length+' unsupported. Review the report before applying.';}catch(error){message.textContent=String(error);}}
 document.getElementById('sample')!.addEventListener('click',()=>{generation++;preview(sample);});
 async function read(event:Event,portable=false){const input=event.target as HTMLInputElement,file=input.files?.[0],request=++generation;input.value='';if(!file)return;pending=null;apply.disabled=true;try{if(file.size>1048576)throw new Error('Choose a file up to 1 MiB.');const text=await file.text();if(!alive||request!==generation)return;if(portable){const document=validatePortableDocument(JSON.parse(text));if(!canvas.loadPortableDocument(document).ok)throw new Error('Finish editing before opening a document.');pending=null;apply.disabled=true;report.replaceChildren();message.textContent='Portable document opened.';}else preview(text);}catch(error){if(alive&&request===generation)message.textContent=String(error);}}
 document.getElementById('source-file')!.addEventListener('change',event=>read(event));
 document.getElementById('portable-file')!.addEventListener('change',event=>read(event,true));
 apply.addEventListener('click',()=>{if(!pending)return;if(canvas.getState().dirty&&!confirm('Replace the current board? Save a portable document first to keep your work.'))return;try{const result=canvas.loadPortableDocument(pending.document);message.textContent=result.ok?'Preview applied. Converted objects are editable.':'Finish editing before applying.';}catch(error){message.textContent=String(error);}});
 let url:string|null=null,timer:ReturnType<typeof setTimeout>|null=null;
 const release=()=>{if(timer)clearTimeout(timer);timer=null;if(url)URL.revokeObjectURL(url);url=null;};
 document.getElementById('save')!.addEventListener('click',()=>{try{const revision=canvas.getState().revision,data=canvas.savePortableDocument();release();url=URL.createObjectURL(new Blob([JSON.stringify(data)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='canvas-portable.json';a.click();canvas.markSaved(revision);timer=setTimeout(release,1000);message.textContent='Portable document saved locally.';}catch(error){message.textContent=String(error);}});
 let frame:number|null=null,lastSize=host.clientWidth+'x'+host.clientHeight;
 const observer=new ResizeObserver(()=>{const size=host.clientWidth+'x'+host.clientHeight;if(size===lastSize)return;lastSize=size;if(frame!==null)cancelAnimationFrame(frame);frame=requestAnimationFrame(()=>{frame=null;pencil.cancel();canvas.execute('cancel');canvas.execute('contain');});});observer.observe(host);
 window.addEventListener('pagehide',()=>{alive=false;generation++;observer.disconnect();if(frame!==null)cancelAnimationFrame(frame);release();off();inspector.dispose();pencil.dispose();canvas.destroy();toolbar.dispose();history.dispose();tools.dispose();theme.dispose();},{once:true});
 window.addEventListener('pageshow',event=>{if(event.persisted)location.reload();});
</script>
<style is:global>
 html{font:16px/1.65 -apple-system,system-ui,"Segoe UI",Roboto,"Helvetica Neue","Noto Sans",Arial,sans-serif;color-scheme:light;background:var(--background);color:var(--foreground)}
 :root[data-theme="dark"]{color-scheme:dark}
 body{margin:0}
 .site-header{box-sizing:border-box;position:sticky;top:0;z-index:30;height:3.5rem;padding:.75rem 1rem;background:var(--background);border-bottom:1px solid var(--border)}
 @media (min-width:50rem){.site-header{padding-inline:1.5rem}}
 main{max-width:1120px;margin:auto;padding:24px}
 h1{font-size:clamp(1.9rem,4vw,2.4rem);font-weight:600;letter-spacing:-.035em;line-height:1.1}
 main>p{color:var(--muted-foreground)}
 a{color:inherit;text-underline-offset:3px}
 .controls{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
 button,input{font:inherit;max-width:100%}
 .controls button{height:32px;padding:0 10px;color:var(--foreground);background:var(--background);border:1px solid var(--border);border-radius:8px;font-size:14px;font-weight:500;cursor:pointer}
 .controls button:hover:not(:disabled){background:var(--accent)}.controls button:disabled{opacity:.5;cursor:default}
 label{display:flex;flex-direction:column;max-width:100%;font-size:14px}
 #message{display:block;margin:16px 0}#report{max-height:240px;overflow:auto;padding-left:24px}
 #host{height:520px;border-color:var(--border);border-radius:8px}#toolbar{margin-top:12px}.canvas-instance-status{font-size:13px}
 :focus-visible{outline:2px solid var(--ring);outline-offset:2px}
 @media(max-width:600px){main{padding:16px}#host{height:440px}}
</style>
</body></html>
