{
  "name": "dmf-canvas",
  "version": "0.7.0-alpha.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Embeddable DOM Canvas — internal extraction preview",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmfeisal/dmf-canvas.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./owners": {
      "types": "./owners.d.ts",
      "import": "./owners.js"
    },
    "./pencil": {
      "types": "./pencil.d.ts",
      "import": "./pencil.js"
    },
    "./clipboard": {
      "types": "./clipboard.d.ts",
      "import": "./clipboard.js"
    },
    "./toolbar": {
      "types": "./toolbar.d.ts",
      "import": "./toolbar.js"
    },
    "./theme": {
      "types": "./theme.d.ts",
      "import": "./theme.js"
    },
    "./drafts": {
      "types": "./drafts.d.ts",
      "import": "./drafts.js"
    },
    "./canvas.css": "./css/canvas-instance.css",
    "./toolbar.css": "./css/canvas-instance-toolbar.css",
    "./images": {
      "types": "./images.d.ts",
      "import": "./images.js"
    },
    "./documents": {
      "types": "./documents.d.ts",
      "import": "./documents.js"
    },
    "./export": {
      "types": "./export.d.ts",
      "import": "./export.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "owners.js",
    "owners.d.ts",
    "pencil.js",
    "pencil.d.ts",
    "clipboard.js",
    "clipboard.d.ts",
    "toolbar.js",
    "toolbar.d.ts",
    "theme.js",
    "theme.d.ts",
    "drafts.js",
    "drafts.d.ts",
    "js",
    "css",
    "assets",
    "LICENSES",
    "README.md",
    "images.js",
    "images.d.ts",
    "CHANGELOG.md",
    "docs/API.md",
    "docs/COMPATIBILITY.md",
    "docs/RELEASE-CHECKLIST.md",
    "docs/INSPECTOR.md",
    "docs/TEXT-FORMATTING.md",
    "docs/design/TOOLBAR.md",
    "documents.js",
    "documents.d.ts",
    "export.js",
    "export.d.ts"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "test:browser": "node test-browser.mjs",
    "check": "npm test && npm run test:types && npm run test:package",
    "test:package": "node scripts/test-package.mjs",
    "test:astro": "node scripts/test-astro.mjs",
    "test:astro:browser": "node scripts/test-astro-browser.mjs",
    "test:frameworks": "node scripts/test-frameworks.mjs",
    "test:frameworks:browser": "node scripts/test-frameworks-browser.mjs",
    "test:configurator": "node scripts/test-configurator.mjs",
    "test:configurator:browser": "node scripts/test-configurator-browser.mjs",
    "test:inspector:browser": "node scripts/test-inspector-browser.mjs",
    "test:text:browser": "node scripts/test-text-browser.mjs",
    "test:shapes:browser": "node scripts/test-shapes-browser.mjs",
    "test:editing:browser": "node scripts/test-editing-browser.mjs",
    "test:navigation:browser": "node scripts/test-navigation-browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "typescript": "6.0.3"
  }
}
